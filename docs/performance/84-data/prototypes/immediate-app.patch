+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cached_pixels_preserve_spans_rotation_transparency_and_edge_padding() {
+        for (orientation, color) in [
+            (Mode::Horizontal, [77, 60, 36, 255]),
+            (Mode::Horizontal, [255, 200, 120, 255]),
+            (Mode::Vertical, [77, 60, 36, 255]),
+            (Mode::Vertical, [255, 200, 120, 255]),
+        ] {
+            assert_raster(orientation, color);
+        }
+    }
+
+    fn assert_raster(orientation: Mode, color: [u8; 4]) {
+        let spans = [
+            Some((-2, 1)),
+            None,
+            Some((0, 0)),
+            Some((4, 4)),
+            Some((-4, -4)),
+        ];
+        let image = raster(&spans, 7, orientation, color).unwrap();
+        let expected = [2..6, 0..0, 3..4, 0..0, 0..0];
+        for (column, filled) in expected.iter().enumerate() {
+            for row in 0..7 {
+                let (x, y) = if orientation.vertical() {
+                    (6 - row, column)
+                } else {
+                    (column, row)
+                };
+                assert_eq!(
+                    image.get_pixel(x as u32 + 1, y as u32 + 1).0,
+                    if filled.contains(&row) { color } else { [0; 4] }
+                );
+            }
+        }
+        for x in 1..image.width() - 1 {
+            assert_eq!(image.get_pixel(x, 0), image.get_pixel(x, 1));
+            assert_eq!(
+                image.get_pixel(x, image.height() - 1),
+                image.get_pixel(x, image.height() - 2)
+            );
+        }
+        for y in 0..image.height() {
+            assert_eq!(image.get_pixel(0, y), image.get_pixel(1, y));
+            assert_eq!(
+                image.get_pixel(image.width() - 1, y),
+                image.get_pixel(image.width() - 2, y)
+            );
+        }
+    }
+}
