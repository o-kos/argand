+/// Opt-in CPU phase timings; these do not include compositor presentation.
+pub struct Phase {
+    label: &'static str,
+    started: Option<Instant>,
+}
+
+impl Phase {
+    pub fn new(label: &'static str) -> Self {
+        Self {
+            label,
+            started: tracing::enabled!(target: "argand::ui_latency", tracing::Level::TRACE)
+                .then(Instant::now),
+        }
+    }
+}
+
+impl Drop for Phase {
+    fn drop(&mut self) {
+        if let Some(started) = self.started {
+            tracing::trace!(target: "argand::ui_latency", phase = self.label,
+                elapsed_us = started.elapsed().as_micros(), "UI phase completed");
+        }
+    }
+}
