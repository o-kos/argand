+impl Cached {
+    fn new(
+        snapshot: &minimap::Snapshot,
+        columns: usize,
+        rows: usize,
+        orientation: Mode,
+    ) -> Option<Self> {
+        let envelope = minimap::rebin(&snapshot.envelope, columns);
+        let half = ((rows.saturating_sub(1)) / 2).max(1) as i64;
+        let spans: Vec<_> = envelope
+            .pixel_spans(columns, half, snapshot.full_scale)
+            .collect();
+        let dark = raster(&spans, rows, orientation, [77, 60, 36, 255])?;
+        let bright = raster(&spans, rows, orientation, [255, 200, 120, 255])?;
+        Some(Self {
+            columns,
+            rows,
+            orientation,
+            textures: [dark, bright]
+                .map(|buffer| Arc::new(RenderImage::new(vec![image::Frame::new(buffer)]))),
+        })
+    }
+
+    fn release(self, window: &mut Window) {
+        for texture in self.textures {
+            spectrogram::retire(Some(texture), window);
+        }
+    }
+}
